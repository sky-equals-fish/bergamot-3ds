diff --git a/src/citra_libretro/ctr_bridge.cpp b/src/citra_libretro/ctr_bridge.cpp
new file mode 100644
index 0000000..bd131e9
--- /dev/null
+++ b/src/citra_libretro/ctr_bridge.cpp
@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "citra_libretro/ctr_bridge.h"
+#include "citra_libretro/core_settings.h"
+#include "common/file_util.h"
+#include "common/string_util.h"
+#include "core/core.h"
+#include "core/file_sys/cia_container.h"
+#include "core/hle/service/am/am.h"
+#include "core/loader/loader.h"
+#include "core/hle/kernel/kernel.h"
+#include "core/hle/kernel/process.h"
+#include "core/memory.h"
+#include <cstring>
+#include <filesystem>
+
+extern "C" int ctr_inspect_content(const char* path, ctr_content_info* info) {
+    if (!path || !info) return -1;
+    *info = {};
+    try {
+        if (Common::ToLower(std::filesystem::path(path).extension().string()) == ".cia") {
+            FileUtil::IOFile file(path, "rb");
+            FileSys::CIAContainer cia;
+            if (cia.Load(&file) != Loader::ResultStatus::Success) return -2;
+            info->title_id = cia.GetTitleMetadata().GetTitleID();
+            info->version = cia.GetTitleMetadata().GetTitleVersion();
+            info->is_cia = 1;
+            info->version_known = 1;
+            info->cia_content_encrypted = cia.GetTitleMetadata().HasEncryptedContent(cia.GetHeader());
+            return 0;
+        }
+        auto loader = Loader::GetLoader(path);
+        if (!loader || loader->ReadProgramId(info->title_id) != Loader::ResultStatus::Success)
+            return -2;
+        return 0;
+    } catch (...) { return -3; }
+}
+
+extern "C" int ctr_install_cia(const char* path, char* output, size_t capacity) {
+    if (!path || !output || !capacity) return -1;
+    output[0] = '\0';
+    if (Core::System::GetInstance().IsPoweredOn()) return -4;
+    try {
+        ctr_content_info info{};
+        const auto inspected = ctr_inspect_content(path, &info);
+        if (inspected || !info.is_cia) return -2;
+        if (info.cia_content_encrypted) return static_cast<int>(Service::AM::InstallStatus::ErrorEncrypted);
+        LibRetro::ParseCoreOptions(); // Establish the host's isolated storage path.
+        const auto result = Service::AM::InstallCIA(path, {});
+        if (result != Service::AM::InstallStatus::Success) return static_cast<int>(result);
+        const auto installed = Service::AM::GetTitleContentPath(
+            Service::AM::GetTitleMediaType(info.title_id), info.title_id, 0);
+        if (installed.size() + 1 > capacity) return -5;
+        std::memcpy(output, installed.c_str(), installed.size() + 1);
+        return 0;
+    } catch (...) { return -3; }
+}
+
+extern "C" int ctr_sample_performance(ctr_perf_info* info) {
+    if (!info) return -1;
+    *info = {};
+    auto& system = Core::System::GetInstance();
+    if (!system.IsPoweredOn()) return -4;
+    const auto stats = system.GetAndResetPerfStats();
+    info->system_fps = stats.system_fps;
+    info->game_fps = stats.game_fps;
+    info->emulation_speed = stats.emulation_speed;
+    info->gpu_seconds = stats.time_gpu;
+    info->swap_seconds = stats.time_swap;
+    return 0;
+}
+
+extern "C" int ctr_read_guest_memory(uint64_t title_id, uint32_t address, void* output, size_t size) {
+    if (!output || !size || size > 4096 || uint64_t(address) + size > 0x100000000ULL) return -1;
+    auto& system = Core::System::GetInstance();
+    if (!system.IsPoweredOn()) return -4;
+    for (const auto& process : system.Kernel().GetProcessList()) {
+        if (!process->codeset || process->codeset->program_id != title_id) continue;
+        for (size_t i = 0; i < size; ++i)
+            if (!system.Memory().IsValidVirtualAddress(*process, address + static_cast<uint32_t>(i))) return -2;
+        system.Memory().ReadBlock(*process, address, output, size);
+        return 0;
+    }
+    return -3;
+}
diff --git a/src/citra_libretro/ctr_bridge.h b/src/citra_libretro/ctr_bridge.h
new file mode 100644
index 0000000..f594b31
--- /dev/null
+++ b/src/citra_libretro/ctr_bridge.h
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Local CTR Runtime extension; not part of the upstream libretro ABI.
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+typedef struct ctr_content_info {
+    uint64_t title_id;
+    uint16_t version;
+    uint8_t is_cia;
+    uint8_t version_known;
+    uint8_t cia_content_encrypted;
+} ctr_content_info;
+// 0 success, negative values are bridge validation failures.
+int ctr_inspect_content(const char* path, ctr_content_info* info);
+// 0 success; positive values are Service::AM::InstallStatus.
+// Call between retro_init and retro_load_game, on the core owner thread.
+int ctr_install_cia(const char* path, char* content_path, size_t capacity);
+typedef struct ctr_perf_info {
+    double system_fps;
+    double game_fps;
+    double emulation_speed;
+    double gpu_seconds;
+    double swap_seconds;
+} ctr_perf_info;
+int ctr_sample_performance(ctr_perf_info* info);
+// Read-only guest inspection, only between retro_run calls on the owner thread.
+int ctr_read_guest_memory(uint64_t title_id, uint32_t address, void* output, size_t size);
+#ifdef __cplusplus
+}
+#endif
