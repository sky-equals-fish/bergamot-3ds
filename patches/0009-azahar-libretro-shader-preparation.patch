@@ -26,8 +26,20 @@ typedef struct ctr_perf_info {
     double swap_seconds;
 } ctr_perf_info;
 int ctr_sample_performance(ctr_perf_info* info);
+// Shader cache preparation. The callback receives the loader's stage (VideoCore::LoadCallbackStage:
+// 0 prepare, 1 preload, 2 decompile, 3 build, 4 complete) with progress while retro_load_game
+// reads the disk cache. Set it before retro_load_game; pass NULL to clear.
+typedef void (*ctr_shader_progress_fn)(void* context, int stage, size_t current, size_t total);
+void ctr_set_shader_progress(ctr_shader_progress_fn callback, void* context);
+// After retro_load_game: blocks until every cached shader and pipeline has finished compiling,
+// so the first frames never wait on a compile. 0 success, -4 no running title.
+int ctr_wait_shader_cache(void);
 // Read-only guest inspection, only between retro_run calls on the owner thread.
 int ctr_read_guest_memory(uint64_t title_id, uint32_t address, void* output, size_t size);
 #ifdef __cplusplus
 }
+namespace LibRetro {
+// Forwards VideoCore disk-cache progress to the callback set by ctr_set_shader_progress.
+void ReportShaderProgress(int stage, size_t current, size_t total);
+}
 #endif
