+extern "C" int ctr_wait_shader_cache(void) {
+    auto& system = Core::System::GetInstance();
+    if (!system.IsPoweredOn()) return -4;
+    try {
+        system.GPU().Renderer().Rasterizer()->WaitDiskResources();
+        return 0;
+    } catch (...) { return -3; }
+}
