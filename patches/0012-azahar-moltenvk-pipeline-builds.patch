diff --git a/src/citra_libretro/libretro_vk.cpp b/src/citra_libretro/libretro_vk.cpp
index b0f7dc4..59c24ba 100644
--- a/src/citra_libretro/libretro_vk.cpp
+++ b/src/citra_libretro/libretro_vk.cpp
@@ -109,8 +109,15 @@ bool CreateVulkanDevice(struct retro_vulkan_context* context, VkInstance instanc
     // For now, let the Instance class handle these decisions
     // AddExtensionIfAvailable(enabled_exts, available_exts,
     // VK_KHR_TIMELINE_SEMAPHORE_EXTENSION_NAME);
-    // AddExtensionIfAvailable(enabled_exts, available_exts,
-    // VK_EXT_EXTENDED_DYNAMIC_STATE_EXTENSION_NAME);
+#ifdef __APPLE__
+    // Bergamot: MoltenVK implements extended dynamic state, which lets depth, cull, stencil and
+    // topology changes reuse one pipeline. Instance still decides whether to use it.
+    // BG_NO_EDS=1 turns it off, to rule it out if a game renders wrongly.
+    const bool has_extended_dynamic_state = !std::getenv("BG_NO_EDS") && AddExtensionIfAvailable(
+        enabled_exts, available_exts, VK_EXT_EXTENDED_DYNAMIC_STATE_EXTENSION_NAME);
+#else
+    const bool has_extended_dynamic_state = false;
+#endif
 
     // Merge frontend's required features with our baseline
     VkPhysicalDeviceFeatures merged_features{};
@@ -184,6 +191,14 @@ bool CreateVulkanDevice(struct retro_vulkan_context* context, VkInstance instanc
         enabled_features.pNext = &custom_border_color_features;
     }
 
+    VkPhysicalDeviceExtendedDynamicStateFeaturesEXT extended_dynamic_state_features{
+        VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTENDED_DYNAMIC_STATE_FEATURES_EXT};
+    if (has_extended_dynamic_state) {
+        extended_dynamic_state_features.extendedDynamicState = VK_TRUE;
+        extended_dynamic_state_features.pNext = enabled_features.pNext;
+        enabled_features.pNext = &extended_dynamic_state_features;
+    }
+
     VkDeviceCreateInfo device_info{VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO};
     device_info.queueCreateInfoCount = 1;
     device_info.pQueueCreateInfos = &queue_info;
