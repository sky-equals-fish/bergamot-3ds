index 5cf8c83..d390740 100644
--- a/src/video_core/renderer_vulkan/vk_graphics_pipeline.cpp
+++ b/src/video_core/renderer_vulkan/vk_graphics_pipeline.cpp
@@ -3,6 +3,10 @@
 // Refer to the LICENSE.txt file included.
 
 #include <boost/container/static_vector.hpp>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <optional>
 
 #include "common/alignment.h"
 #include "common/hash.h"
@@ -108,6 +112,29 @@ bool GraphicsPipeline::TryBuild(bool wait_built) {
 
 bool GraphicsPipeline::Build(bool fail_on_compile_required) {
     MICROPROFILE_SCOPE(Vulkan_Pipeline);
+    // Bergamot diagnostic: BG_PIPE_LOG=1 prints one BGPIPE line per pipeline build (time, keys).
+    static const bool bg_pipe_log = std::getenv("BG_PIPE_LOG") != nullptr;
+    struct BgPipeTimer {
+        const GraphicsPipeline* self; bool quick; std::chrono::steady_clock::time_point start;
+        ~BgPipeTimer() {
+            const auto end = std::chrono::steady_clock::now();
+            const auto& st = self->info.state;
+            const u64 shaders = Common::HashCombine(st.shader_ids[0], st.shader_ids[1], st.shader_ids[2]);
+            std::fprintf(stderr,
+                "BGPIPE t=%.3f ms=%.2f quick=%d full=%016llx eds=%016llx sh=%016llx bl=%016llx at=%016llx vl=%016llx rs=%02x ds=%05x\n",
+                std::chrono::duration<double>(start.time_since_epoch()).count(),
+                std::chrono::duration<double, std::milli>(end - start).count(), quick ? 1 : 0,
+                (unsigned long long)Common::ComputeStructHash64(st),
+                (unsigned long long)Common::HashCombine(shaders, Common::ComputeStructHash64(st.vertex_layout),
+                    Common::ComputeStructHash64(st.attachments), Common::ComputeStructHash64(st.blending)),
+                (unsigned long long)shaders, (unsigned long long)Common::ComputeStructHash64(st.blending),
+                (unsigned long long)Common::ComputeStructHash64(st.attachments),
+                (unsigned long long)Common::ComputeStructHash64(st.vertex_layout),
+                (unsigned)st.rasterization.value, (unsigned)st.depth_stencil.value);
+        }
+    };
+    std::optional<BgPipeTimer> bg_pipe_timer;
+    if (bg_pipe_log) bg_pipe_timer.emplace(this, fail_on_compile_required, std::chrono::steady_clock::now());
 
     const u32 stride_alignment = instance.GetMinVertexStrideAlignment();
     std::array<vk::VertexInputBindingDescription, MAX_VERTEX_BINDINGS> bindings;
