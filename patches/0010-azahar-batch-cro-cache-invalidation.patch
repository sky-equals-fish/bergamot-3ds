     void InvalidateCacheRange(u32 start_address, std::size_t length) {
+        if (cache_batch_depth > 0) {
+            // Bergamot: defer to the end of the batch, one pass per run of touched pages.
+            if (length == 0) {
+                return;
+            }
+            const u64 end = static_cast<u64>(start_address) + length - 1;
+            for (u64 page = start_address >> 12; page <= (end >> 12); ++page) {
+                cache_batch_pages.push_back(static_cast<u32>(page));
+            }
+            return;
+        }
         for (const auto& cpu : cpu_cores) {
             cpu->InvalidateCacheRange(start_address, length);
         }
     }
 
     /**
+     * Bergamot: groups instruction-cache invalidations made while no guest code can run, such
+     * as the thousands of 4-byte relocation patches applied when a CRO module is linked. Each
+     * InvalidateCacheRange call otherwise walks every decoded block on every core; a batch
+     * collapses them into one walk per contiguous run of touched 4 KiB pages when it closes.
+     */
+    class CacheInvalidationBatch {
+    public:
+        explicit CacheInvalidationBatch(System& system_) : system{system_} {
+            ++system.cache_batch_depth;
+        }
+        ~CacheInvalidationBatch() {
+            if (--system.cache_batch_depth == 0) {
+                system.FlushCacheInvalidationBatch();
+            }
+        }
+        CacheInvalidationBatch(const CacheInvalidationBatch&) = delete;
+        CacheInvalidationBatch& operator=(const CacheInvalidationBatch&) = delete;
+
+    private:
+        System& system;
+    };
+
+    void FlushCacheInvalidationBatch() {
+        auto& pages = cache_batch_pages;
+        std::sort(pages.begin(), pages.end());
+        pages.erase(std::unique(pages.begin(), pages.end()), pages.end());
+        for (std::size_t i = 0; i < pages.size();) {
+            std::size_t j = i + 1;
+            while (j < pages.size() && pages[j] == pages[j - 1] + 1) {
+                ++j;
+            }
+            const u32 start = pages[i] << 12;
+            const std::size_t length = static_cast<std::size_t>(j - i) << 12;
+            for (const auto& cpu : cpu_cores) {
+                cpu->InvalidateCacheRange(start, length);
+            }
+            i = j;
+        }
+        pages.clear();
+    }
+
+    /**
      * Gets a reference to the emulated DSP.
      * @returns A reference to the emulated DSP.
      */
@@ -491,6 +545,9 @@
 
